TOP_DELIVERY_RUN_ID=goal-example-run
TOP_DELIVERY_ARTIFACT_ROOT=/var/lib/top-delivery
TOP_DELIVERY_DATABASE_URL=postgresql:///top_delivery_control_p1
TOP_DELIVERY_ADAPTER_CONFIG=/etc/top-delivery/adapters.json
TOP_DELIVERY_WORKER_OWNER=top-delivery-worker
TOP_DELIVERY_WORKER_POLL_SECONDS=5

# Credential env var names are declared in adapters.json; never place secret values here.
