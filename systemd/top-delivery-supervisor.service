[Unit]
Description=TOP-DELIVERY durable parent supervisor
After=top-delivery-controller.service

[Service]
Type=simple
WorkingDirectory=/opt/top-delivery/controller
ExecStart=/usr/bin/python3 /opt/top-delivery/controller/supervisor_cli.py
EnvironmentFile=-/etc/top-delivery/supervisor.env
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/top-delivery
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
