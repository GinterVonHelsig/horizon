# Copy to /etc/top-delivery/signal-adapter.env with mode 0640 root:topdelivery.
TOP_DELIVERY_SIGNAL_ACCOUNT=+15555550100
TOP_DELIVERY_SIGNAL_RECIPIENT=+15555550101
TOP_DELIVERY_SIGNAL_FINGERPRINT=replace-with-pinned-identity-fingerprint
TOP_DELIVERY_SIGNAL_RPC=http://127.0.0.1:8080/api/v1/rpc
TOP_DELIVERY_AUTH_RPC=http://127.0.0.1:8787
TOP_DELIVERY_AUTH_INTERNAL_TOKEN=operator-supplied-local-token
TOP_DELIVERY_CONTROLLER_SOCKET=/run/top-delivery/controller.sock
TOP_DELIVERY_SIGNAL_DB=/var/lib/top-delivery/signal.sqlite3
TOP_DELIVERY_OPERATOR_ID=operator-01
